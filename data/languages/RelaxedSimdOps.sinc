@include "Leb128_opc2_2b.sinc"
@define NAME "opc2_261"
@define N0 5
@define N1 2
@include "Leb128_opc2_2b.sinc"
@define NAME "opc2_262"
@define N0 6
@define N1 2
@include "Leb128_opc2_2b.sinc"
@define NAME "opc2_263"
@define N0 7
@define N1 2
@include "Leb128_opc2_2b.sinc"
