# Threads proposal: atomic memory instructions (0xFE prefix). Added for wasm-ghidra; generated.
# Atomicity does not matter to the decompiler: loads and stores are plain memory accesses, read-modify-write returns
# the old value, cmpxchg stores only when the old value equals the expected one. wait/notify are callothers.

atomicaddr3: memalign memoffset is memalign; memoffset; sp3_32 {
	addr:4 = memoffset:4 + sp3_32;
	export addr;
}

