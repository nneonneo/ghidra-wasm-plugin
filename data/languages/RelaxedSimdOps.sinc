define pcodeop i8x16_relaxed_swizzle;
:i8x16.relaxed_swizzle is opc=0xFD; opc2_256; sp1_128; sp2_128; ctx_is_directive=0 {
    sp2_128 = i8x16_relaxed_swizzle(sp1_128, sp2_128);
}
define pcodeop i32x4_relaxed_trunc_f32x4_s;
:i32x4.relaxed_trunc_f32x4_s is opc=0xFD; opc2_257; sp1_128; ctx_is_directive=0 {
    sp1_128 = i32x4_relaxed_trunc_f32x4_s(sp1_128);
}
