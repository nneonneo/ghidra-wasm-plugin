# Relaxed SIMD (0xFD 0x100-0x113). Added for wasm-ghidra; generated. Like the plugin's other vector instructions they
# are callothers on 128-bit stack slots (operands top-first, as in VectorOps.sinc).

@define NAME "opc2_256"
@define N0 0
@define N1 2
@include "Leb128_opc2_2b.sinc"
@define NAME "opc2_257"
@define N0 1
@define N1 2
@include "Leb128_opc2_2b.sinc"
@define NAME "opc2_258"
@define N0 2
@define N1 2
@include "Leb128_opc2_2b.sinc"
